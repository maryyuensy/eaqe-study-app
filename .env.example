# 本機範本；複製至 .env.local。所有私密欄位保持空白。
# preview／production 必須使用 HTTPS，且每個環境使用獨立資料專案。
APP_ENV=local
APP_BASE_URL=http://localhost:5173
DATA_ENV=
# 發布帳戶前須確認條款／私隱文件，並填入實際文件版本。
AUTH_ENABLED=false
APP_TERMS_VERSION=
APP_PRIVACY_VERSION=

# 下列是清單中的候選服務設定，不代表已選定或連接供應商。
# 公開金鑰只可用於瀏覽器登入；secret key 只在伺服器設定。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# 第一版開發階段只允許 disabled／test，真實收款尚未開放。
PAYMENTS_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 供應商、預算及保存期限由營運者確認後填入，沒有預設收費額度。
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_BUDGET_HKD=
AI_ACCOUNT_BUDGET_HKD=
AI_CHAT_RETENTION_DAYS=
