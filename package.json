{
  "name": "propexam-hk",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": "24.x"},
  "scripts": {
    "dev": "node server.mjs",
    "test": "node qa.mjs",
    "test:core": "node qa.mjs --core-only",
    "test:launch": "node scripts/qa-launch.mjs",
    "test:backend": "node --test tests/backend.test.mjs",
    "check:env": "node scripts/check-environment.mjs",
    "test:ci": "npm run test:core && npm run test:launch && npm run test:backend && npm run audit:questions && npm run audit:content-rights",
    "audit:questions": "node scripts/audit-question-bank.mjs",
    "audit:content-rights": "node scripts/export-content-audit.mjs"
  }
}
