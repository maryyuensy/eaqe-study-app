{
  "name": "propexam-hk",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": "24.x"},
  "scripts": {
    "dev": "node server.mjs",
    "test": "node qa.mjs",
    "test:core": "node qa.mjs --core-only",
    "test:launch": "node scripts/qa-launch.mjs",
    "test:backend": "node --test tests/backend.test.mjs tests/application.test.mjs",
    "test:contracts": "node --test tests/payment-contract.test.mjs tests/ai-context.test.mjs",
    "test:frontend": "node --test tests/frontend-*.test.mjs",
    "test:database": "node --test tests/database-*.test.mjs",
    "test:content-audit": "node --test tests/content-audit.test.mjs tests/content-release.test.mjs tests/commercial-build.test.mjs",
    "audit:content": "node scripts/audit-question-content.mjs",
    "audit:publication": "node scripts/audit-question-content.mjs --publication",
    "build:review-policy": "node scripts/export-review-policy.mjs",
    "build:commercial": "node scripts/build-commercial.mjs",
    "prepare:question-import": "node scripts/prepare-question-import.mjs",
    "check:env": "node scripts/check-environment.mjs",
    "test:ci": "npm run test:core && npm run test:launch && npm run test:backend && npm run test:contracts && npm run test:frontend && npm run test:database && npm run test:content-audit && npm run audit:questions && npm run audit:content-rights",
    "audit:questions": "node scripts/audit-question-bank.mjs",
    "audit:content-rights": "node scripts/export-content-audit.mjs"
  }
}
